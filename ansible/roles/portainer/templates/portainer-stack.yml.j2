# Portainer CE + agent sur chaque nœud du Swarm
# Inspiré du stack officiel https://downloads.portainer.io/ce-lts/portainer-agent-stack.yml
services:
  agent:
    image: portainer/agent:{{ portainer_version }}
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock
      - /var/lib/docker/volumes:/var/lib/docker/volumes
      - /:/host
    networks:
      - agent_network
    deploy:
      mode: global # un agent par nœud
      placement:
        constraints: [node.platform.os == linux]

  portainer:
    image: portainer/portainer-ce:{{ portainer_version }}
    command: >
      -H tcp://tasks.agent:9001 --tlsskipverify
      --admin-password-file /run/secrets/portainer_admin_password
    ports:
      - target: 9443
        published: 9443
        protocol: tcp
        mode: host # pas de routing mesh : Portainer n'écoute que sur ce manager
    volumes:
      - portainer_data:/data
    networks:
      - agent_network
    secrets:
      - portainer_admin_password
    deploy:
      mode: replicated
      replicas: 1
      placement:
        # Épinglé sur le premier manager : c'est là que vit le volume portainer_data
        constraints: [node.hostname == {{ inventory_hostname }}]

networks:
  agent_network:
    driver: overlay
    attachable: true

volumes:
  portainer_data:

secrets:
  portainer_admin_password:
    external: true
